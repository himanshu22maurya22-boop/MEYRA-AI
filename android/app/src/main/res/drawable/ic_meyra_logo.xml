<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="48"
    android:viewportHeight="48">

    <!-- Left Wing Outer Pillar -->
    <path
        android:pathData="M8,38 L8,14 L16,8 L16,32 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="8"
                android:startY="38"
                android:endX="16"
                android:endY="8"
                android:type="linear">
                <item android:offset="0" android:color="#4F46E5" />
                <item android:offset="1" android:color="#818CF8" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Right Wing Outer Pillar -->
    <path
        android:pathData="M40,38 L40,14 L32,8 L32,32 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="40"
                android:startY="38"
                android:endX="32"
                android:endY="8"
                android:type="linear">
                <item android:offset="0" android:color="#7C3AED" />
                <item android:offset="1" android:color="#A78BFA" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Left Inward Facet to Nexus -->
    <path
        android:pathData="M16,8 L24,24 L16,32 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="16"
                android:startY="8"
                android:endX="24"
                android:endY="32"
                android:type="linear">
                <item android:offset="0" android:color="#6366F1" />
                <item android:offset="1" android:color="#4338CA" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Right Inward Facet to Nexus -->
    <path
        android:pathData="M32,8 L24,24 L32,32 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="32"
                android:startY="8"
                android:endX="24"
                android:endY="32"
                android:type="linear">
                <item android:offset="0" android:color="#9333EA" />
                <item android:offset="1" android:color="#6D28D9" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Central Neural Prism / Core Diamond -->
    <path
        android:pathData="M24,19 L28,24 L24,29 L20,24 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="20"
                android:startY="19"
                android:endX="28"
                android:endY="29"
                android:type="linear">
                <item android:offset="0" android:color="#38BDF8" />
                <item android:offset="1" android:color="#C084FC" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Base Horizon Foundation Bar -->
    <path
        android:pathData="M11,38 L37,38 L34,42 L14,42 Z"
        android:fillColor="#1E1E2D" />

    <!-- Radiant Apex Spark -->
    <path
        android:pathData="M24,7 L25.5,10 L28,11 L25.5,12 L24,15 L22.5,12 L20,11 L22.5,10 Z"
        android:fillColor="#38BDF8" />

</vector>
