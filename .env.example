# GEMINI_API_KEY: Required for MEYRA AI to generate real AI responses.
# In Google AI Studio, this is automatically configured.
# In local development (VS Code), obtain a free Gemini API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your_gemini_api_key_here"

# PORT: Server port (default is 3000)
PORT=3000

# APP_URL: The URL where this app is hosted (optional in local dev)
APP_URL="http://localhost:3000"

