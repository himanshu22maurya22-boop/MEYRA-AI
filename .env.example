# GEMINI_API_KEY: Required for MEYRA AI to generate real AI responses.
# In Google AI Studio, this is automatically configured.
# In local development (VS Code), obtain a free Gemini API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your_gemini_api_key_here"

# PORT: Server port (default is 3000)
PORT=3000

# APP_URL: The URL where this app is hosted (optional in local dev)
APP_URL="http://localhost:3000"

# VITE_GOOGLE_CLIENT_ID: Google OAuth 2.0 Web Client ID for authentic Google Sign-In
# Obtain from https://console.cloud.google.com/apis/credentials (Application type: Web application)
VITE_GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_ID=""

# GOOGLE_CLIENT_SECRET: Optional server-side secret if using server-side authorization code flow.
# SECURITY NOTICE: Never prefix with VITE_. Never expose to client bundles or browser code.
GOOGLE_CLIENT_SECRET=""

# REAL EMAIL OTP DELIVERY CONFIGURATION (Option A: SMTP e.g. Gmail App Password, Option B: Resend)
# Option A - Gmail / Custom SMTP:
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="MEYRA AI <no-reply@meyra.ai>"

# Option B - Resend API Key:
RESEND_API_KEY=""

# Cryptographic secret for signing authenticated session tokens
SESSION_SECRET=""

# WEB SEARCH ENGINE INTEGRATIONS:
# Primary live web search: Tavily API (Used as primary provider for verified real-time web search)
TAVILY_API_KEY=""

# OPTIONAL FALLBACK PROVIDER (Optional):
# SERPER_API_KEY is completely optional. If omitted, MEYRA AI uses Tavily as primary,
# and automatically falls back to built-in zero-config live search when needed.
# SERPER_API_KEY=""


